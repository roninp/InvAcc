# =============================================================================
# Конфигурация Finam Trade API (тариф «Про»)
# -----------------------------------------------------------------------------
# Скопируйте этот файл в .env.local и заполните реальное значение.
# Файл .env.local в .gitignore — секрет не должен попадать в систему контроля
# версий. Токен получают на портале Финама: https://api.finam.ru/tokens/
# =============================================================================

# Секретный токен Finam Trade API (обязателен для мгновенных котировок)
FINAM_API_SECRET="tapi_sk_ВАШ_СЕКРЕТ"

# Номер брокерского счёта (account_id) для метода /assets/{symbol}/params.
# Указывается без префикса «КлФ» — только номерные символы (см. личный кабинет
# Финама, формат «КлФ-<номер>»). Если не задан — лот берётся из fallback (MOEX ISS),
# а не напрямую из Finam. Желательно задать, чтобы лоты шли из Finam API.
FINAM_ACCOUNT_ID=""
# Разрешить подключение к Finam API при корпоративном SSL-перехвате
# (самоподписанный сертификат в цепочке). Отключает проверку сертификата!
# Только для локальной разработки, значение "1" активирует обход.
FINAM_TLS_INSECURE=1

# =============================================================================
# Конфигурация Supabase (аутентификация пользователей)
# -----------------------------------------------------------------------------
# URL проекта и публикуемый (publishable) ключ. Значения видно в
# Dashboard → Project Settings → API. Ключ публичный — безопасен для браузера.
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://hqpskrzxodjhbnucguww.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."