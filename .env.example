# =============================================================================
# Конфигурация Finam Trade API (тариф «Про»)
# -----------------------------------------------------------------------------
# Скопируйте этот файл в .env.local и заполните реальное значение.
# Файл .env.local в .gitignore — секрет не должен попадать в систему контроля
# версий. Токен получают на портале Финама: https://api.finam.ru/tokens/
# =============================================================================

# Секретный токен Finam Trade API (обязателен для мгновенных котировок)
FINAM_API_SECRET="tapi_sk_ВАШ_СЕКРЕТ"

# Разрешить подключение к Finam API при корпоративном SSL-перехвате
# (самоподписанный сертификат в цепочке). Отключает проверку сертификата!
# Только для локальной разработки, значение "1" активирует обход.
FINAM_TLS_INSECURE=1